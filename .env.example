# XPLODE environment configuration
# Copy this file to .env and fill in real values. NEVER commit the real .env.

# Required in production: signs login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required to use the admin endpoints (deposit queue, SMS auto-credit, fortune
# codes) and the operator panel at /admin.html.
# Any long random string. Requests must send it as the X-Admin-Key header.
ADMIN_KEY=

# HTTP port (default 3000)
PORT=3000

# SQLite database file (default ./xplode.db)
# DB_PATH=./data/xplode.db

# Set to production when deploying (enables strict checks)
# NODE_ENV=production

# Dedicated admin account (auto-created on first start if missing)
ADMIN_USERNAME=xplode-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_PIN=00000

# Long random string; sessions stay valid across restarts
